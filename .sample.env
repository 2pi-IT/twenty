# lead-ai dev stack config. Copy to twenty/.env (`make env` in lead-ai does this and generates ENCRYPTION_KEY).

# Twenty
TWENTY_PORT=3000
SERVER_URL=http://localhost:3000   # must match TWENTY_PORT
ENCRYPTION_KEY=                    # openssl rand -base64 32

# Postgres
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=postgres
PG_DATABASE_NAME=default
PG_PORT=5432                       # host port, for psql / DB clients
